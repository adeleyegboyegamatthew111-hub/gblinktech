<script>
window.addEventListener('load', () => { document.getElementById('loader').style.display = 'none'; });

function toggleTheme(){
  document.body.classList.toggle('light');
  localStorage.setItem('theme', document.body.classList.contains('light')? 'light' : 'dark');
}
if(localStorage.getItem('theme') === 'light') document.body.classList.add('light');

let cart = [];
const ADMIN_PHONE = "2348084499959";
const PAYSTACK_KEY = "pk_live_YOUR_LIVE_KEY_HERE"; // REPLACE THIS
const FLUTTERWAVE_KEY = "FLWPUBK_YOUR_LIVE_KEY_HERE"; // REPLACE THIS

function addToCart(name, price) { cart.push({name, price}); updateCart(); toggleCart(); }
function updateCart() {
  document.getElementById('cartCount').innerText = cart.length;
  let items = document.getElementById('cartItems'); items.innerHTML = ''; let total = 0;
  cart.forEach(item => { total += item.price; items.innerHTML += `<div style="display:flex; justify-content:space-between; padding:12px 0; border-bottom:1px solid #334155;">${item.name} <span>$${item.price}</span></div>`; });
  document.getElementById('cartTotal').innerText = total;
}
function toggleCart() { document.getElementById('cart').classList.toggle('active'); }

// ERROR HANDLING ADDED - ZERO ERROR FOR CUSTOMERS
function handlePaymentError(gateway, error){
  console.error(gateway + " Error:", error);
  alert(`❌ Payment could not be processed. Please try another method or contact us on WhatsApp: +2348084499959\nError: ${error || 'Network issue'}`);
}

function checkoutPaystack() {
  if(cart.length === 0) return alert('Cart is empty');
  let total = cart.reduce((sum, item) => sum + item.price, 0);
  let customerEmail = prompt("Enter your email for receipt:");
  if(!customerEmail) return;
  try {
    let handler = PaystackPop.setup({
      key: PAYSTACK_KEY, 
      email: customerEmail, 
      amount: total * 100,
      currency: "USD",
      ref: 'GBLNK_'+Date.now(),
      channels: ['card', 'bank', 'ussd', 'qr', 'bank_transfer'],
      callback: function(response){ successPayment('Paystack', response.reference); },
      onClose: function(){}
    });
    handler.openIframe();
  } catch(e) { handlePaymentError('Paystack', e.message); }
}

function checkoutFlutterwave() {
  if(cart.length === 0) return alert('Cart is empty');
  let total = cart.reduce((sum, item) => sum + item.price, 0);
  let customerEmail = prompt("Enter your email for PayPal/Card:");
  if(!customerEmail) return;
  try {
    FlutterwaveCheckout({
      public_key: FLUTTERWAVE_KEY,
      tx_ref: 'GBLNK_FW_'+Date.now(),
      amount: total,
      currency: "USD",
      country: "US",
      payment_options: "card, banktransfer, ussd, paypal, mobilemoney",
      customer: { email: customerEmail, name: "GBLINK Client" },
      customizations: { title: "GBLINK Tech Payment", description: cart.map(i=>i.name).join(', ') },
      callback: function (data) {
        if(data.status === "successful"){ successPayment('Flutterwave', data.transaction_id); }
        else { handlePaymentError('Flutterwave', 'Payment not successful'); }
      },
      onclose: function() {},
    });
  } catch(e) { handlePaymentError('Flutterwave', e.message); }
}

function successPayment(gateway, ref){
  document.getElementById('successRef').innerText = ref;
  document.getElementById('successText').innerText = `Thank you! Payment via ${gateway} was successful. Our CEO will contact you on WhatsApp in 5 minutes to start your project.`;
  document.getElementById('successModal').style.display = 'flex';
  let orderDetails = cart.map(i=>i.name).join(', ');
  window.open(`https://wa.me/${ADMIN_PHONE}?text=New%20PAID%20Order%20${gateway}:%20${orderDetails}%20-%20Ref:%20${ref}`, '_blank');
  cart = []; updateCart(); toggleCart();
}

function closeSuccessModal(){ document.getElementById('successModal').style.display = 'none'; }
function payWithBank(){ let total = cart.reduce((sum, item) => sum + item.price, 0); document.getElementById('modalTotal').innerText = total; document.getElementById('bankModal').style.display = 'flex'; }
function closeBankModal(){ document.getElementById('bankModal').style.display = 'none'; }
function copyReferral(){ navigator.clipboard.writeText("https://gblink.tech?ref=YOUR_NAME"); alert('Referral link copied! Share it to earn 15%'); }

document.getElementById('contactForm').addEventListener('submit', function(e){
  e.preventDefault(); const formData = new FormData(this);
  let msg = `New Lead from GBLINK Website:\nName: ${formData.get('name')}\nEmail: ${formData.get('email')}\nMessage: ${formData.get('message')}`;
  window.open(`https://wa.me/${ADMIN_PHONE}?text=${encodeURIComponent(msg)}`, '_blank'); this.reset();
  alert('Message sent! We will reply on WhatsApp within 2 hours.');
});
</script>
